# ==============================================================================
# Infrasync AI - Backend Environment Configuration Template
# ==============================================================================

PROJECT_NAME="Infrasync AI"
API_V1_STR="/api"
HOST=0.0.0.0
PORT=<HOST_PROVIDED_PORT>

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Local Development default:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oil_ai_copilot"

# Production (Supabase PostgreSQL):
# Format: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require
DATABASE_URL=<SUPABASE_POSTGRES_CONNECTION_STRING>

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE & CLIENT INTEGRATION
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
SUPABASE_URL=<EXISTING_SUPABASE_URL>

# Supabase Service Role Secret Key (Server-side ONLY - never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Supabase Storage Bucket for persistent project uploads
SUPABASE_STORAGE_BUCKET=infrasync-project-files

# ------------------------------------------------------------------------------
# 3. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (localhost origins are always preserved)
# Production example: https://infrasync-ai.vercel.app
CORS_ORIGINS=<PRODUCTION_FRONTEND_URL>

# ------------------------------------------------------------------------------
# 4. AI & OCR CONFIGURATION (Local / Free)
# ------------------------------------------------------------------------------
AI_PROVIDER=auto
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:26b"
OLLAMA_TIMEOUT_SECONDS=1.5
