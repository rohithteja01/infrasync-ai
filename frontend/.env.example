# ==============================================================================
# Infrasync AI - Frontend Production Environment Template
# ==============================================================================

# Public Application Title
VITE_APP_TITLE="Infrasync AI"

# Backend API Base URL
# Development: Leave empty or unset so requests route to Vite dev proxy (localhost:8000)
# Production: Set to your deployed FastAPI backend URL (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=<PRODUCTION_BACKEND_URL>

# Supabase Authentication & Storage Client Configuration
# Public Project URL (found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=<EXISTING_SUPABASE_URL>

# Supabase Anonymous/Publishable Key (Safe for browser client)
VITE_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
